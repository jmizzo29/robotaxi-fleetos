VITE_MAPBOX_TOKEN=your_mapbox_public_token

# Clerk browser key — enables secure sign-in modals (Account page, OAuth).
# Get your publishable key at https://dashboard.clerk.com → API Keys.
# Copy this file to .env.local or add the line to your existing .env (never commit real keys).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

PUBLIC_APP_URL=https://roboagent-fleet.vercel.app
TESLA_REDIRECT_URI=https://roboagent-fleet.vercel.app/api/tesla/callback

# Local development only. Production uses Vercel /api automatically.
VITE_LOCAL_API_BASE=http://localhost:3001/api
VITE_ADMIN_INVITE_CODE=FLEETOS-ADMIN

# AI runs through /api/ai/analyze; provider API keys belong in backend/.env or Vercel env vars.

# Optional server-side key for OpenEI utility rates.
# Free key: https://developer.nrel.gov/signup/
# If omitted, FleetOS attempts DEMO_KEY where supported and degrades gracefully.
# OPENEI_API_KEY=your_open_ei_or_nrel_key

# PredictHQ for event-driven demand surges (used in pricingEngine for dynamic caps).
# Get token at https://www.predicthq.com/
# Used in backend/src/services/pricingEngine.js (local dev) and should be set in Vercel env for prod.
# PREDICTHQ_TOKEN=phq_your_token_here

# Server-side only on Vercel, not exposed to the browser:
# DATABASE_URL=postgres://user:password@host:5432/database
# TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
#
# Owner alert web push (optional). Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=https://roboagent-fleet.vercel.app
# CRON_SECRET=
