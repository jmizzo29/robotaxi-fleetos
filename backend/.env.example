PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=

# Public origin the browser actually reaches the app on. Leave blank for normal
# localhost dev. For MOBILE/LAN testing, set this to the host your phone uses so
# the Tesla OAuth redirect lands somewhere the phone can reach, e.g.
#   APP_PUBLIC_ORIGIN=http://192.168.1.50:5173   (LAN IP of your dev machine)
#   APP_PUBLIC_ORIGIN=https://your-tunnel.ngrok.io   (recommended: HTTPS tunnel)
# When set, the Tesla callback becomes <APP_PUBLIC_ORIGIN>/api/tesla/callback,
# which Vite proxies back to this server. If left blank, the backend auto-derives
# the origin from the proxied request (X-Forwarded-Host) when xfwd is enabled.
# NOTE: whatever callback URL results MUST be registered in your Tesla developer
# portal "Allowed Redirect URI(s)". Tesla requires HTTPS, so for real phones use
# an HTTPS tunnel (ngrok/cloudflared) rather than a raw http://LAN-IP.
APP_PUBLIC_ORIGIN=

# Tesla Fleet API
# Use either a short-lived access token or a client id + refresh token.
TESLA_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_AUTH_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
TESLA_AUTHORIZE_URL=https://auth.tesla.com/oauth2/v3/authorize
# Desktop dev default. On mobile/LAN the backend derives
# <your-phone-host><this-path> (e.g. http://192.168.1.50:5173/callback).
# That exact URL must be registered in the Tesla developer portal, OR set
# APP_PUBLIC_ORIGIN to an HTTPS tunnel and register the tunnel callback instead.
TESLA_REDIRECT_URI=http://localhost:3001/callback
TESLA_SCOPES=openid offline_access user_data vehicle_device_data vehicle_location vehicle_charging_cmds
TESLA_CLIENT_ID=your_tesla_fleet_api_client_id
TESLA_CLIENT_SECRET=
TESLA_PARTNER_DOMAIN=your-vercel-domain.vercel.app
TESLA_PARTNER_SCOPES=openid vehicle_device_data vehicle_cmds vehicle_charging_cmds
TESLA_REFRESH_TOKEN=your_tesla_refresh_token
TESLA_ACCESS_TOKEN=
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# AI analysis layer
# AI_PROVIDER can be "anthropic", "xai", or blank for local heuristic fallback.
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional free OpenEI/NREL key for utility-rate context.
# Get one at https://developer.nrel.gov/signup/
OPENEI_API_KEY=
